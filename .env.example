# QueueX - Smart Virtual Queue Management System
# Target: CGC University, Mohali, Punjab, India

FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-to-a-secure-random-key-in-production

# Port binding (Render auto-sets PORT)
PORT=5000

# Database Configuration:
# Leave empty for local SQLite (auto-creates queuex.db)
# On Render / Production PostgreSQL:
# e.g. DATABASE_URL=postgresql://user:password@host:5432/queuex_db
DATABASE_URL=

# Cookie Security (set to 1 on HTTPS / Render)
SESSION_COOKIE_SECURE=1

# Initial Admin & Operator Credentials (Auto-seeded if empty DB)
ADMIN_EMAIL=admin@cgc.edu.in
ADMIN_DEFAULT_PASSWORD=Admin@QueueX2026

OPERATOR_EMAIL=operator@cgc.edu.in
OPERATOR_DEFAULT_PASSWORD=Operator@QueueX2026
