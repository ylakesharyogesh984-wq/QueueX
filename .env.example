# ==============================================================================
# QueueX Environment Configuration Template
# Copy this file to .env for local development or set variables in Railway Dashboard
# ==============================================================================

# ---------- APPLICATION & RUNTIME ----------
# Set to 'production' for Railway, 'development' for local development
FLASK_ENV=development
# Set to 0 in production; set to 1 only during local debugging
FLASK_DEBUG=0
# Listening port (Railway automatically populates PORT)
PORT=5000

# ---------- CRYPTOGRAPHIC SECRETS ----------
# Session signing key - generate a secure random 32+ character hex string in production
# Example: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace_with_a_secure_random_key_in_production

# Enforce secure HTTPS-only cookies (automatically enabled when RAILWAY_ENVIRONMENT is detected)
SESSION_COOKIE_SECURE=false

# ---------- DATABASE CONFIGURATION ----------
# Production PostgreSQL connection URL (automatically provisioned by Railway PostgreSQL plugin)
# Example: postgresql://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=

# Local SQLite database path (used only when DATABASE_URL is not set)
DATABASE_PATH=database.db

# Safety override: by default, QueueX blocks SQLite in production to prevent data loss.
# Set to 1 only if intentionally using SQLite with a Railway persistent volume mounted at /data
ALLOW_SQLITE_IN_PRODUCTION=0

# ---------- ADMINISTRATIVE CREDENTIALS ----------
# Default Super Admin credentials for executive command center (/admin/login)
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change_this_admin_password_in_production
# Secret key required to register new administrator accounts at /admin/register
ADMIN_REGISTRATION_KEY=change_this_admin_registration_key

# ---------- OPERATOR TERMINAL CREDENTIALS ----------
# Default Counter Operator credentials (/operator/login)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change_this_operator_password_in_production

# ---------- REAL-TIME SOCKET.IO (OPTIONAL) ----------
# Optional Redis message queue URL for multi-worker scaling on Railway
# Example: redis://default:password@redis.railway.internal:6379
REDIS_URL=
